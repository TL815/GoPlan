String _planDateRangeLabel(TravelPlan plan) {
  final parts = plan.dateRange.split('~');
  if (parts.length != 2) return plan.dateRange;
  final startParts = parts.first.split('.');
  final endParts = parts.last.split('.');
  if (startParts.length != 3 || endParts.length != 3) return plan.dateRange;
  return '${startParts[1]}/${startParts[2]}-${endParts[1]}/${endParts[2]}';
}

String _planDetailDescription(TravelPlan plan) {
  final start = plan.routeStops.first.label;
  final end = plan.routeStops.last.label;
  return '杩欐槸涓€娈典负鏈?{plan.days}澶╃殑涓枃鏃呰璁″垝锛岃矾绾夸粠$start鍑哄彂涓€璺姷杈?end锛屼覆鑱?{plan.places}涓伒鎰熷湴鐐癸紝閫傚悎${plan.members}浜哄悓琛屻€傝绋嬪吋椤惧煄甯傛极姝ャ€佽嚜鐒堕鏅笌鏈湴浜烘枃浣撻獙锛岃妭濂忚垝閫傦紝閫傚悎绗竴娆℃帰绱㈣繖鏉¤矾绾跨殑鏃呰鑰呫€?';
}

String _planCoverAsset(TravelPlan plan) {
  if (plan.title.contains('闈掔敇')) return 'assets/images/photo-xinjiang.png';
  if (plan.title.contains('宸濊タ')) return 'assets/images/photo-sichuan.png';
  if (plan.title.contains('鏉窞')) {
    return 'assets/images/c7fada39e6124c21b44577c65e25f962.webp';
  }
  if (plan.title.contains('浜戝崡')) return 'assets/images/photo-neimenggu.png';
  return _planCoverAssetFallback;
}

String _planCoverKeyword(TravelPlan plan) {
  if (plan.title.contains('闈掔敇')) return '闈掓捣婀栨櫙鍖?';
  if (plan.title.contains('宸濊タ')) return '鍥涘濞樺北鏅尯';
  if (plan.title.contains('鏉窞')) return '瑗挎箹椋庢櫙鍚嶈儨鍖?';
  if (plan.title.contains('浜戝崡')) return '棣欐牸閲屾媺鏅揪鎺浗瀹跺叕鍥?';
  return plan.routeStops.last.label;
}

String _planCoverCity(TravelPlan plan) {
  if (plan.title.contains('闈掔敇')) return '瑗垮畞';
  if (plan.title.contains('宸濊タ')) return '闃垮潩';
  if (plan.title.contains('鏉窞')) return '鏉窞';
  if (plan.title.contains('浜戝崡')) return '杩簡';
  return '';
}

