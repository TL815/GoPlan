class _TimelinePoiImage extends StatelessWidget {
  const _TimelinePoiImage({required this.plan, required this.day});

  final TravelPlan plan;
  final _DailyPlan day;

  @override
  Widget build(BuildContext context) {
    return FutureBuilder<String?>(
      future: fetchAmapPhotoUrl(
        keyword: _timelinePoiKeyword(plan, day),
        city: _planCoverCity(plan),
      ),
      builder: (context, snapshot) {
        final url = snapshot.data;
        if (url != null && url.isNotEmpty) {
          return Image.network(
            url,
            fit: BoxFit.cover,
            filterQuality: FilterQuality.high,
            errorBuilder: (_, _, _) => _TimelinePoiAssetFallback(plan: plan),
          );
        }
        return _TimelinePoiAssetFallback(plan: plan);
      },
    );
  }
}

class _TimelinePoiAssetFallback extends StatelessWidget {
  const _TimelinePoiAssetFallback({required this.plan});

  final TravelPlan plan;

  @override
  Widget build(BuildContext context) {
    return Image.asset(
      _planCoverAsset(plan),
      fit: BoxFit.cover,
      filterQuality: FilterQuality.high,
    );
  }
}

String _timelinePoiKeyword(TravelPlan plan, _DailyPlan day) {
  final stopIndex = ((day.index - 1) * plan.routeStops.length) ~/ plan.days;
  final stop = plan.routeStops[stopIndex.clamp(0, plan.routeStops.length - 1)];
  final title = day.title.replaceAll('鈫?', ' ').trim();
  return title.isEmpty ? stop.label : title;
}

