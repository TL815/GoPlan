class _PoiFact {
  const _PoiFact({
    required this.icon,
    required this.label,
    required this.value,
  });

  final IconData icon;
  final String label;
  final String value;
}

List<_PoiFact> _poiFactItems(_HomePhotoItem item) {
  final amapFacts = _amapPoiFactItems(item.amapSpot);
  if (amapFacts.isNotEmpty) return amapFacts;

  return [
    _PoiFact(
      icon: Icons.info_outline,
      label: '鏉ユ簮',
      value: item.isNetwork ? '楂樺痉 POI' : '鏈湴鍏滃簳鍐呭',
    ),
    _PoiFact(
      icon: Icons.location_city_outlined,
      label: '鍖哄煙',
      value: item.spot.city,
    ),
    if (item.spot.tags.isNotEmpty)
      _PoiFact(
        icon: Icons.local_offer_outlined,
        label: '鏍囩',
        value: item.spot.tags.join(' / '),
      ),
  ];
}

List<_PoiFact> _amapPoiFactItems(AmapPhotoSpot? spot) {
  if (spot == null) return const [];

  final facts = <_PoiFact>[
    if (spot.rating.isNotEmpty)
      _PoiFact(icon: Icons.star_rounded, label: '璇勫垎', value: spot.rating),
    if (spot.openTime.isNotEmpty)
      _PoiFact(
        icon: Icons.access_time_rounded,
        label: '寮€鏀?',
        value: spot.openTime,
      ),
    if (spot.cost.isNotEmpty)
      _PoiFact(
        icon: Icons.confirmation_number_outlined,
        label: '浠锋牸',
        value: spot.cost,
      ),
    if (spot.tel.isNotEmpty)
      _PoiFact(icon: Icons.phone_outlined, label: '鐢佃瘽', value: spot.tel),
    if (spot.businessArea.isNotEmpty)
      _PoiFact(
        icon: Icons.storefront_outlined,
        label: '鍟嗗湀',
        value: spot.businessArea,
      ),
    if (spot.address.isNotEmpty)
      _PoiFact(icon: Icons.place_outlined, label: '鍦板潃', value: spot.address),
    if (spot.website.isNotEmpty)
      _PoiFact(icon: Icons.public_outlined, label: '瀹樼綉', value: spot.website),
    if (spot.location.isNotEmpty)
      _PoiFact(
        icon: Icons.gps_fixed_outlined,
        label: '鍧愭爣',
        value: spot.location,
      ),
    if (spot.photoUrls.length > 1)
      _PoiFact(
        icon: Icons.photo_library_outlined,
        label: '鍥剧墖',
        value: '${spot.photoUrls.length} 寮?',
      ),
  ];

  return facts.take(8).toList(growable: false);
}

String _homePhotoSpotDescription(_HomePhotoItem item) {
  final spot = item.amapSpot;
  if (spot == null) {
    return '${item.spot.name}褰撳墠灞曠ず鏈湴鍏滃簳鍐呭銆傞珮寰?POI 鏈繑鍥炲彲鐢ㄥ浘鐗囨垨璇︽儏鏃讹紝浼氬厛浣跨敤杩欎唤鍦扮偣璧勬枡淇濇寔椤甸潰鍙祻瑙堛€?{item.spot.description}';
  }

  final address = spot.address.isEmpty ? spot.city : spot.address;
  final parts = <String>[
    '${spot.name}浣嶄簬$address銆?',
    if (spot.category.isNotEmpty) '楂樺痉鍒嗙被涓?{spot.category}銆?',
    if (spot.rating.isNotEmpty) '褰撳墠 POI 璇勫垎涓?{spot.rating}銆?',
    if (spot.openTime.isNotEmpty) '寮€鏀炬椂闂翠负${spot.openTime}銆?',
    if (spot.cost.isNotEmpty) '浠锋牸/浜哄潎鍙傝€冧负${spot.cost}銆?',
    if (spot.businessArea.isNotEmpty) '鎵€鍦ㄥ晢鍦堜负${spot.businessArea}銆?',
  ];

  parts.add('杩欎簺淇℃伅鏉ヨ嚜楂樺痉 POI锛屽彲浣滀负鍔犲叆琛岀▼鍓嶇殑鍩虹鍙傝€冦€?');
  return parts.join();
}

